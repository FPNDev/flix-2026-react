{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/exhaustive-deps": "off",
    "curly": ["error", "all"],
    "unicorn/no-array-for-each": "error"
  },
  "ignorePatterns": [
    "dist/*",
    "dev-dist/*",
    "scripts/*",
    "pre-commit/*",
    "src/vendor/*"
  ]
}
